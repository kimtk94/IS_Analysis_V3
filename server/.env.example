# Copy to server/.env on the server and edit locally. Never commit real secrets.
IS_ANALYSIS_ROOT=/srv/is-analysis
MIN_FREE_GIB=40
MAX_STAGING_GIB=35

POSTGRES_DB=is_analysis
POSTGRES_USER=is_analysis
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Synapse token stays in a separate chmod-600 file and is sourced only for jobs.
SYNAPSE_ENV_FILE=/home/taehoon/.config/is-analysis/synapse.env

# Optional Google Drive backup configuration.
RCLONE_CONFIG=/home/taehoon/.config/rclone/rclone.conf
