# Runtime configuration must be injected into containers, never copied into an image.
**/.env
**/*.env
**/.env.*
!**/.env.example
**/.synapseConfig
**/.synapseCache
**/.ssh
**/credentials.json
**/rclone.conf
**/*.pem
**/*.key

# Keep the image limited to code and reviewed fixtures.
.git
**/__pycache__
**/.pytest_cache
**/*.pyc
**/.venv*
data/rawdata
data/koges
data/KoGES
**/koges_raw
**/KoGES_raw
results
artifacts
legacy
state
logs
backup
**/*.log
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
